<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
    rlMenuProfiles.xml
    GUI profiles for the RL Tabbed Menu (new standalone menu system).
    Separate from gui/guiProfiles.xml to keep the migration boundary clean.

    Profiles are namespaced rlMenu_* table profile family.
-->
<GUIProfiles>

    <!-- =========================================================== -->
    <!-- Table/list profiles for RL Menu frames                      -->
    <!-- =========================================================== -->

    <!-- Table container background -->
    <Profile name="rlMenu_tableList" extends="emptyPanel" with="anchorTopLeft pivotTopLeft">
        <imageColor value="$preset_fs25_colorGreyDark_50"/>
    </Profile>

    <!-- Alternating row template -->
    <Profile name="rlMenu_tableListItem" extends="baseReference" with="anchorTopStretchingX alternating">
        <height value="48px"/>
        <imageColor value="$preset_fs25_colorGrey"/>
        <imageSelectedColor value="$preset_fs25_colorMainHighlight"/>
        <alternateBackgroundColor value="$preset_fs25_colorGreyDark_50"/>
    </Profile>

    <!-- Table header cells -->
    <Profile name="rlMenu_tableHeaderLeftAligned" extends="baseReference">
        <imageColor value="0 0 0 0"/>
        <textFocusedColor value="$preset_fs25_colorMainHighlight"/>
        <textHighlightedColor value="$preset_fs25_colorMainHighlight"/>
        <textSize value="16px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textColor value="$preset_colorWhite_50"/>
        <textAlignment value="left"/>
        <textDisabledColor value="$preset_colorDisabled"/>
    </Profile>

    <Profile name="rlMenu_tableHeaderRightAligned" extends="rlMenu_tableHeaderLeftAligned">
        <textAlignment value="right"/>
    </Profile>

    <Profile name="rlMenu_tableHeaderCentered" extends="rlMenu_tableHeaderLeftAligned">
        <textAlignment value="center"/>
    </Profile>

    <!-- Table row cells -->
    <Profile name="rlMenu_tableRowCellLeftAligned" extends="baseReference" with="anchorStretchingYLeft">
        <textBold value="false"/>
        <textSize value="15px"/>
        <textAlignment value="left"/>
        <textColor value="$preset_fs25_colorMainLight"/>
        <textSelectedColor value="$preset_fs25_colorMainDark"/>
        <textDisabledColor value="$preset_colorDisabled"/>
    </Profile>

    <Profile name="rlMenu_tableRowCellRightAligned" extends="rlMenu_tableRowCellLeftAligned">
        <textAlignment value="right"/>
    </Profile>

    <Profile name="rlMenu_tableRowCellCentered" extends="rlMenu_tableRowCellLeftAligned">
        <textAlignment value="center"/>
    </Profile>

    <!-- Summary row at the bottom of a table -->
    <Profile name="rlMenu_tableSummary" extends="emptyPanel" with="anchorStretchingYLeft pivotTopLeft">
    </Profile>

    <!-- Generic container for grouping (used by SmoothList + scrollbar wrapper) -->
    <Profile name="rlMenu_container" extends="baseReference" with="anchorTopLeft">
    </Profile>

    <!-- Importance indicator icon (full-color, no select tinting) -->
    <Profile name="rlMenu_importanceIcon" extends="emptyPanel" with="anchorTopLeft">
        <imageColor value="1 1 1 1"/>
        <imageSelectedColor value="1 1 1 1"/>
    </Profile>

    <!-- Herdsman/mark descriptor badge on Info tab animal cards. -->
    <Profile name="rlMenu_animalCardBadge" extends="fs25_animalSourceListItemAmount" with="anchorBottomRight">
        <width value="200px"/>
        <position value="-30px 17px"/>
        <textSize value="13px"/>
    </Profile>

    <!--
        Phase 2b1: pen icon profile for the Info tab.

        Override resizes and repositions the icon to sit inside the Info
        tab's narrow column (the default `fs25_animalPenIcon` profile only
        fits a wider host).
    -->
    <!--
        Pen icon for the Info tab. Mirrors the legacy fs25_animalHusbandryIcon
        usage: square 280x280, anchored top-center, positioned 160px below
        the column top so it sits below the pen name + count text rows.
    -->
    <Profile name="rlMenu_penIcon" extends="baseReference" with="anchorTopCenter">
        <size value="220px 220px"/>
        <position value="0px -110px"/>
        <imageSliceId value="noSlice"/>
    </Profile>

    <!--
        "PEN INFORMATION" header. Mirrors the legacy fs25_animalTextTransportTo
        usage: fs25_textDefault (15px) + uppercase
        + centered. The earlier rlMenu_penInfoHeader extended
        fs25_animalRequirementsHeaderLong (22px bold) which was too large
        and left-aligned for the narrow column.
    -->
    <Profile name="rlMenu_penInfoHeader" extends="fs25_textDefault" with="anchorTopCenter">
        <width value="350px"/>
        <textMaxWidth value="350px"/>
        <textAlignment value="center"/>
        <textUpperCase value="true"/>
    </Profile>

    <!--
        Pen name text (e.g. "COW BARN WITH FEEDING ROBOT (GEA)"). Slightly
        larger than the header so it reads as the dominant identifier in
        the column, but well below the 32px species-title size that
        fs25_animalIconTitle would inflict.
    -->
    <Profile name="rlMenu_penNameText" extends="fs25_textDefault" with="anchorTopCenter">
        <width value="350px"/>
        <textMaxWidth value="270px"/>
        <textMaxNumLines value="2"/>
        <textSize value="20px"/>
        <textAlignment value="center"/>
        <textUpperCase value="true"/>
        <textBold value="true"/>
    </Profile>

    <!--
        Pen "current/max" count line. Default 15px, single-line, centered.
    -->
    <Profile name="rlMenu_penCountText" extends="fs25_textDefault" with="anchorTopCenter">
        <width value="350px"/>
        <textMaxWidth value="270px"/>
        <textMaxNumLines value="1"/>
        <textAlignment value="center"/>
    </Profile>

    <!--
        Animal info column layout. Two of these sit side-by-side inside
        the wide animal box: pedigree on the left, genetics on the right.
        Vertical BoxLayout flow, fixed 320px wide, anchored top-left so
        explicit `position` in the XML places each column at its own X.
    -->
    <!--
        Cart total value: right-aligned green text at header size (22px bold).
        Extends fs25_animalRequirementsValue (right-aligned, green highlight)
        with the font sizing from fs25_animalRequirementsHeader (22px bold)
        to make the total row visually prominent.
    -->
    <Profile name="rlMenu_cartTotalValue" extends="fs25_animalRequirementsValue">
        <textSize value="22px"/>
        <textBold value="true"/>
    </Profile>

    <!--
        AI tab quantity stepper. Extends the `fs25_animalAmountSelector`
        profile (the same profile the legacy AI screen uses with an inline
        `width="100%"` override to fill the parent column). This profile
        encapsulates that override so the frame XML stays clean.

        Additional overrides:
          - `anchorTopStretchingX` (instead of inheriting `anchorBottomCenter`)
            spans the parent's full horizontal width. `anchorTopCenter` would
            place the widget in the right half of the parent, not centered
            across it, so it is not used here.
          - `position` reset to 0,0 (the inherited profile carries a Y offset
            appropriate for its original bottom-anchored host; not needed when
            this widget flows as a BoxLayout child).
          - `absoluteSizeOffset` overridden to shrink the widget by 40px
            (see below).
    -->
    <Profile name="rlMenu_aiQuantitySelector" extends="fs25_animalAmountSelector" with="anchorTopStretchingX">
        <size value="100% 42px"/>
        <!--
            Shrink the stretched 100% width by 40px total (20px each side).
            FS25 `absoluteSizeOffset` uses SUBTRACTIVE semantics: a POSITIVE
            value reduces the effective size. Runtime-verified: -40px
            produced a 430px-wide widget (panel +40), +40px produces the
            correct 350px widget so it sits inside the 390px panel with
            20px of breathing room on each side.
        -->
        <absoluteSizeOffset value="40px 0px"/>
        <position value="0px 0px"/>
    </Profile>

    <!--
        Cart fee info text: multiline grey text sized for the pen column.
        Mirrors rlMenu_animalDescription pattern (resize layout mode) but
        narrower (350px vs 640px) to fit the pen column.
    -->
    <Profile name="rlMenu_cartFeeInfo" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="350px 80px"/>
        <textMaxWidth value="350px"/>
        <textMaxNumLines value="3"/>
        <textLayoutMode value="resize"/>
        <textVerticalAlignment value="top"/>
    </Profile>

    <Profile name="rlMenu_animalColumnLayout" extends="emptyPanel" with="anchorTopLeft">
        <size value="360px 400px"/>
        <flowDirection value="vertical"/>
        <autoValidateLayout value="true"/>
    </Profile>

    <!--
        Inline animal description paragraph (the "INFORMATION" text).
        Top-anchored so it sits between the can-reproduce row and the
        two-column pedigree/genetics area. Top-anchoring is required here
        because a bottom-anchored variant would overlap the BoxLayout
        above when its rows extend into the bottom region.
    -->
    <Profile name="rlMenu_animalDescription" extends="fs25_textGrey" with="anchorTopCenter pivotTopCenter">
        <size value="640px 100px"/>
        <textMaxWidth value="640px"/>
        <textMaxNumLines value="4"/>
        <textLayoutMode value="resize"/>
        <textVerticalAlignment value="top"/>
    </Profile>

    <!--
        Animal info section header (PEDIGREE / GENETICS / DISEASES).
        Centered + smaller than fs25_animalRequirementsHeaderLong (which
        is left-aligned 22px) so it sits cleanly above each column.
    -->
    <Profile name="rlMenu_animalSectionHeader" extends="fs25_textDefault" with="anchorTopStretchingX">
        <textBold value="true"/>
        <textSize value="16px"/>
        <textUpperCase value="true"/>
        <textAlignment value="left"/>
        <margin value="0px 0px 0px 6px"/>
    </Profile>

    <!--
        Smaller animal image profile for the Info tab. The Info tab hosts the
        icon in a wider column with more content underneath (description + 2
        columns + disease), so this override shrinks the icon and lifts it to
        free vertical space.
    -->
    <Profile name="rlMenu_animalImage" extends="fs25_animalIcon">
        <size value="200px 200px"/>
        <position value="0px -10px"/>
    </Profile>

    <Profile name="rlMenu_animalImageGradient" extends="fs25_animalIconGradient">
        <size value="320px 200px"/>
        <position value="0px -10px"/>
    </Profile>

    <!-- Smaller animal type name, positioned just below the smaller image. -->
    <Profile name="rlMenu_animalTypeName" extends="fs25_animalIconTitle">
        <position value="0px -200px"/>
        <textSize value="22px"/>
    </Profile>

    <!--
        Stats grid label/value text profiles. Mirrors the legacy
        AnimalScreen.xml stats grid (infoTitle / infoValue rows), which
        renders stats as plain label/value text in a 2x5 grid - NOT as
        rows-with-bars (that pattern is used elsewhere for conditions/
        food and is a separate idiom).
    -->
    <Profile name="rlMenu_animalStatLabel" extends="fs25_animalInfoTitle">
        <textSize value="14px"/>
        <textMaxWidth value="145px"/>
    </Profile>
    <Profile name="rlMenu_animalStatValue" extends="fs25_animalInfoValue">
        <textSize value="14px"/>
        <textMaxWidth value="200px"/>
    </Profile>

    <!--
        Flow-child wrapper for the animal image + type name inside the
        ScrollingLayout. Height covers: 10px top pad + 200px image +
        25px type name text = 235px.
    -->
    <Profile name="rlMenu_animalImageSection" extends="emptyPanel" with="anchorTopStretchingX">
        <height value="235px"/>
    </Profile>

    <!--
        Flow-child wrapper for the 2x5 stat grid inside the
        ScrollingLayout. 5 rows x 35px spacing starting at -10px,
        each row ~20px text height = 10+140+20 = 170px + 15px pad = 185px.
    -->
    <Profile name="rlMenu_animalStatsSection" extends="emptyPanel" with="anchorTopStretchingX">
        <height value="185px"/>
    </Profile>

    <!--
        Wide animal column container. Extends `fs25_animalPenInfoContainer`
        and overrides the height offset + horizontal position so the
        column fills the available space without overlapping the footer
        and sits a touch left of where the inherited profile would land.
        Tuning numbers were chosen empirically from runtime measurement
        at 16:9.
    -->
    <Profile name="rlMenu_animalContainer" extends="fs25_animalPenInfoContainer">
        <!--
            Height offset 140 clears the footer / action bar at the
            bottom. Smaller values caused the bottom rows to overlap the
            footer; 140 leaves a clean margin.

            Position X = -105 shifts the column slightly toward the pen
            column without overlapping it.
        -->
        <absoluteSizeOffset value="0px 140px"/>
        <position value="-105px 0px"/>
    </Profile>

    <!--
        Transparent wrapper around the animal scroll area. Uses
        imageSliceId="gui.colorPreset" + imageColor="$preset_colorTransparent"
        so the Bitmap renders nothing visible while still serving as the
        sized host for the ScrollingLayout inside. (Without an imageSliceId
        the Bitmap would render the entire texture atlas; with imageSliceId
        "noSlice" and no imageFilename it would still render an artifact.)
    -->
    <Profile name="rlMenu_animalScrollDebugBg" extends="baseReference" with="anchorStretchingYStretchingX pivotTopLeft">
        <size value="100% 100%"/>
        <absoluteSizeOffset value="-30px -30px"/>
        <position value="15px -15px"/>
        <imageSliceId value="gui.colorPreset"/>
        <imageColor value="$preset_colorTransparent"/>
    </Profile>

    <!--
        Scrollable layout for animal info content. Vertical ScrollingLayout
        with fitFlowToElements + clipping. Empty for now; content added
        incrementally after position is verified.
    -->
    <Profile name="rlMenu_animalScrollLayout" extends="baseReference" with="anchorStretchingYStretchingX pivotTopLeft">
        <size value="100% 100%"/>
        <wrapAround value="false"/>
        <fitFlowToElements value="true"/>
        <flowDirection value="vertical"/>
        <clipping value="true"/>
        <imageColor value="$preset_colorTransparent"/>
    </Profile>

    <!--
        Horizontal wrapper for the two pedigree/genetics columns. Lives
        inside the vertical ScrollingLayout so its children flow side-by-side
        as one block in the scrollable column.
    -->
    <Profile name="rlMenu_animalColumnsRow" extends="emptyPanel" with="anchorTopStretchingX">
        <height value="240px"/>
        <flowDirection value="horizontal"/>
        <autoValidateLayout value="true"/>
    </Profile>

    <!--
        Stat row cell in the 2x5 grid. Invisible container with explicit
        size; absolute position set per-cell in the XML.
    -->
    <Profile name="rlMenu_statCell" extends="emptyPanel" with="anchorTopLeft">
        <size value="360px 30px"/>
    </Profile>

    <!--
        Generic row wrapper for genetics/disease inside columns.
        Flow child in a vertical BoxLayout; 28px gives room for
        14px text + padding.
    -->
    <Profile name="rlMenu_infoRow" extends="emptyPanel" with="anchorTopStretchingX">
        <height value="28px"/>
    </Profile>

    <!--
        Pedigree text line (flow child in column BoxLayout).
        Single-line, 14px, stretches to column width.
    -->
    <Profile name="rlMenu_pedigreeText" extends="fs25_textDefault" with="anchorTopStretchingX">
        <height value="25px"/>
        <textSize value="14px"/>
        <textMaxNumLines value="1"/>
        <textMaxWidth value="310px"/>
    </Profile>

    <!--
        Full-width vertical section wrapper. Used by the INFORMATION
        section to group header + description in a BoxLayout (matching
        how PEDIGREE/GENETICS group their header + content rows).
    -->
    <Profile name="rlMenu_fullWidthSection" extends="emptyPanel" with="anchorTopStretchingX">
        <height value="120px"/>
        <flowDirection value="vertical"/>
        <autoValidateLayout value="true"/>
    </Profile>

    <!--
        Status indicator icon on animal list cards.
        16x16 bitmap, anchorTopLeft. Each icon instance sets its own
        position in the XML. Color is set per-cell via setImageColor
        in the populate callback (white base lets tinting work).
    -->
    <Profile name="rlMenu_statusIcon" extends="emptyPanel" with="anchorBottomRight">
        <size value="18px 18px"/>
        <imageColor value="1 1 1 1"/>
        <imageSelectedColor value="$preset_fs25_colorMainDark"/>
        <imageHighlightedColor value="$preset_fs25_colorMainDark"/>
        <imageFocusedColor value="1 1 1 1"/>
    </Profile>

    <!-- =========================================================== -->
    <!-- Checkbox profiles for Move tab animal list cards             -->
    <!-- Mirrors legacy rl_checkbox* from AnimalScreen.xml:928-955   -->
    <!-- =========================================================== -->

    <!--
        Outer button container. Anchored top-right of the list cell,
        transparent so only the inner box + tick are visible.
    -->
    <Profile name="rlMenu_checkboxButton" extends="buttonBase" with="anchorTopRight">
        <width value="25px"/>
        <position value="-45px -25px"/>
        <imageColor value="$preset_colorTransparent"/>
    </Profile>

    <!--
        Checkbox box background (green square border). ThreePartBitmap
        with left/right edge slices for a clean rounded-rect look.
    -->
    <Profile name="rlMenu_checkboxBox" extends="emptyPanel">
        <imageSliceId value="ui_elements.square_center"/>
        <imageColor value="$preset_fs25_colorMainHighlight"/>
        <imageSelectedColor value="$preset_colorRed"/>
        <imageHighlightedColor value="$preset_fs25_colorMainHighlight"/>
        <imageFocusedColor value="$preset_fs25_colorMainHighlight"/>
        <startImageSize value="5px"/>
        <startImageSliceId value="ui_elements.square_left"/>
        <startImageColor value="$preset_fs25_colorMainHighlight"/>
        <startImageSelectedColor value="$preset_colorRed"/>
        <endImageSize value="5px"/>
        <endImageSliceId value="ui_elements.square_right"/>
        <endImageColor value="$preset_fs25_colorMainHighlight"/>
        <endImageSelectedColor value="$preset_colorRed"/>
    </Profile>

    <!--
        Checkmark icon (gui.tick). Visible when animal is selected,
        hidden when not. Toggled by populateCellForItemInSection.
    -->
    <Profile name="rlMenu_checkbox" extends="buttonBase">
        <imageSliceId value="gui.tick"/>
        <imageColor value="$preset_fs25_colorMainHighlight"/>
        <imageSelectedColor value="$preset_colorRed"/>
        <position value="3px 0px"/>
    </Profile>

    <!-- =========================================================== -->
    <!-- Filter chip: readonly active-filter indicator    -->
    <!-- in each frame's left sidebar. Extends fs25_textDefault with -->
    <!-- anchorTopLeft so position="28px -125px" places the chip     -->
    <!-- below the dot indicators (bottom at y=-115) and above the   -->
    <!-- animal list container (top at y=-145), left-aligned with    -->
    <!-- the husbandry/type selector's left-arrow button at x=28.   -->
    <!-- =========================================================== -->
    <Profile name="rlMenu_filterChip" extends="fs25_textDefault" with="anchorTopLeft"/>

    <!--
        Right-pane container for the Saveable Filters editor. Sits
        as sibling to filtersListContainer (fs25_subCategoryContainer, 410px
        fixed width) inside subCategoryPages[2].

        Cannot reuse fs25_subCategoryContainer: that profile uses
        anchorStretchingYLeft which only Y-stretches and pins X to the
        profile's fixed width=410px - inline size/absoluteSizeOffset cannot
        override the anchor's width-pin (runtime-measured 410x783px instead
        of expected 1088x783px).

        Mirrors the rlMenu_animalScrollLayout pattern in this file:
        anchorStretchingYStretchingX + size 100% 100% + pivotTopLeft to
        fill the parent both axes. Then position="410px 0px" shifts the
        start right past the sidebar; absoluteSizeOffset trims the width by
        LESS than the 410px start offset (280px), so the editor's right edge
        extends past the parent into the right margin - room for the in-row
        help tooltip before the ScrollingLayout clip. Rows are left-anchored
        fixed-width, so the extra width is unused right margin only; the
        filter editor (which reuses this profile) is visually unchanged.
    -->
    <Profile name="rlMenu_filterEditorContainer" extends="emptyPanel" with="anchorStretchingYStretchingX pivotTopLeft">
        <size value="100% 100%"/>
        <position value="410px 0px"/>
        <absoluteSizeOffset value="280px 0px"/>
    </Profile>

    <!--
        rlMenu_herdsmanContentContainer

        Content wrapper for the Herdsman frame's master-detail. Extends the
        base subcategory page container but trims its top reservation so the
        master-detail floats up into the band the tab-bar chrome occupies in
        the Settings frame - the Herdsman frame has no subcategory tab bar -
        filling the area below the header with a small clearance. The trim was
        set from the onFrameOpen measurement (content top lands just below the
        header baseline), not guessed.
    -->
    <Profile name="rlMenu_herdsmanContentContainer" extends="fs25_subCategorySelectorTabbedContainer">
        <absoluteSizeOffset value="0px 23px"/>
    </Profile>


    <!--
        rlMenu_filterEditorMiddle

        Stretching middle region for the filter editor's conditions
        list container. Sits between the fixed-height metadata layout at
        top and the bottom-anchored footer row. Uses anchorStretchingY so
        the height adapts to the editor pane's actual height (varies with
        screen aspect ratio), and absoluteSizeOffset reserves space for
        the top (280px metadata layout) and bottom (60px footer row + small
        gap) regions. emptyPanel extends baseReference (anchorBottomLeft)
        which is the wrong anchor for stretching - so this profile overrides
        with the correct trait.
    -->
    <!--
        Pivot/position math notes for future maintainers:

        - With pivotBottomLeft, position.Y offsets the element's bottom
          upward from the parent's bottom edge. positive Y -> element
          rises within the parent.
        - With pivotTopLeft, position.Y offsets the element's top
          upward from the parent's top edge. positive Y -> element rises
          above the parent's top (typically off-screen).

        We want the element's bottom just above the editor pane's bottom,
        with the top landing right under the metadata layout. Verified
        via runtime measurement on a 783-tall parent at 16:9.
    -->
    <!--
        Conditions list container: stretches to the parent's bottom edge
        with absoluteSizeOffset 290px reserving the metadata layout on top
        (the [+ condition] action lives on the action bar, not in-pane, so
        no extra footer reservation is needed).
    -->
    <Profile name="rlMenu_filterEditorMiddle" extends="emptyPanel" with="anchorStretchingYStretchingX pivotBottomCenter">
        <size value="100% 100%"/>
        <position value="0px 0px"/>
        <!-- Width offset 90px centers the container horizontally so the
             condition rows align with the metadata rows above. Height
             offset 290px reserves room for the metadata layout on top. -->
        <absoluteSizeOffset value="90px 290px"/>
    </Profile>

    <!--
        rlMenu_filterConditionRow

        Row template for a condition inside the conditions SmoothList.
        The `alternating` trait makes the SmoothList framework auto-tint
        adjacent rows using `imageColor` and `alternateBackgroundColor`;
        no manual tint pass needed. Without the trait the row paints the
        bright white `gui.colorPreset` fallback. Tint values are chosen
        to match the General-subtab rows visually.
    -->
    <Profile name="rlMenu_filterConditionRow" extends="baseReference" with="anchorTopStretchingX alternating">
        <height value="50px"/>
        <imageColor value="0.02956 0.02956 0.02956 0.2"/>
        <imageSelectedColor value="$preset_fs25_colorMainHighlight"/>
        <alternateBackgroundColor value="0.02956 0.02956 0.02956 0.6"/>
    </Profile>

    <!--
        rlMenu_filterConditionsList

        SmoothList container for condition rows. Extends fs25_subCategoryList
        for the standard scroll + clipping behavior but pins
        `listItemSpacing` to 0px. The parent profile is reused elsewhere
        in this frame for card-style lists with negative spacing; flat
        data rows need 0 spacing to render without overlap.
    -->
    <Profile name="rlMenu_filterConditionsList" extends="fs25_subCategoryList">
        <listItemSpacing value="0px"/>
    </Profile>

    <!--
        rl_filterConditionText

        Single-line Text profile used as the row content for the conditions
        list. The row template is a read-only display of the formatted
        condition ("age >= 30"); editing routes through RLFilterConditionDialog
        instead of inline widgets. White-on-grey, left-aligned, indent-friendly
        (Phase 2 group depth applies a left position offset). Selection
        highlight is handled by the parent rlMenu_filterConditionRow's
        imageSelectedColor.
    -->
    <Profile name="rl_filterConditionText" extends="baseReference" with="anchorTopLeft">
        <textBold value="false"/>
        <textSize value="18px"/>
        <textAlignment value="left"/>
        <textColor value="$preset_fs25_colorMainLight"/>
        <textSelectedColor value="$preset_fs25_colorMainDark"/>
    </Profile>

    <Profile name="rl_filterList" extends="fs25_subCategoryList"/>

    <Profile name="rl_filterListItem" extends="fs25_subCategoryListItem" with="anchorTopStretchingX">
        <height value="70px"/>
        <imageSliceId value="gui.map_box"/>
        <imageSelectedSliceId value="gui.map_box_selected"/>
        <imageHighlightedSliceId value="gui.map_box_hover"/>
    </Profile>

    <!-- Title size inherits from the chain (do not override <size>; the
         override shifts the MIDDLE-aligned glyph downward in the row). -->
    <Profile name="rl_filterListItemName" extends="fs25_subCategoryListItemName" with="anchorTopLeft">
        <width value="300px"/>
        <position value="20px -16px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textAlignment value="left"/>
        <textLayoutMode value="scrolling"/>
    </Profile>

    <!--
        Polish: preserved-conditions / subType-refuse
        banner. Anchored above the conditions list so warnings render
        above the list rows rather than inside them. x=50 aligns the
        banner's left edge with the conditions-row text inset.
        Note: the same element is reused by RLMenuSettingsFrame as a
        transient subType-refuse surface (see openConditionEditDialog).
        Both messages now appear at this above-list location - acceptable
        UX since both are above-list warnings.
    -->
    <Profile name="rl_filterConditionsBanner" extends="fs25_textDefault" with="anchorTopLeft pivotTopLeft">
        <size value="100% 30px"/>
        <absoluteSizeOffset value="90px 0px"/>
        <!-- y offset places banner_bottom just above the conditions list
             top with a small visual gap. Tuned via in-game measurement. -->
        <position value="50px -258px"/>
        <textAlignment value="left"/>
    </Profile>

    <!--
        Legacy-active coexistence banner: a fixed-text caution shown in the header, directly
        below the Herdsman title, while legacy herdsman tasks are still enabled on a husbandry
        (the migration-window double-execution hazard). Orange ($preset_colorOrange) reads as a
        caution without the red "error" weight. Hidden by default; RLMenuHerdsmanFrame:refreshBanner
        toggles it. x matches the title inset; y is a first guess tuned by the onFrameOpen
        measurement log, not eyeballed.
    -->
    <Profile name="rl_herdsmanLegacyBanner" extends="fs25_textDefault" with="anchorTopLeft pivotTopLeft">
        <size value="1400px 26px"/>
        <position value="100px -58px"/>
        <textSize value="19px"/>
        <textBold value="true"/>
        <textColor value="$preset_colorOrange"/>
        <textAlignment value="left"/>
        <textUpperCase value="false"/>
        <visible value="false"/>
    </Profile>

    <!-- Per-row help line for the herdsman rule editor (RLMenuHerdsmanFrame). Lives as a
         child of each row's value WIDGET (the legacy rl_aiTooltip home in AnimalScreen.xml), NOT the
         row container (which clips to its bounds). Extends the base tooltip profile and overrides
         ONLY the position (into the right margin past the editor's value column) and a narrower width
         so the help wraps inside the editor's widened right margin instead of running off one line.
         Tune position/width via the onFrameOpen geometry log + dev hot-reload, not by eye. -->
    <Profile name="rlMenu_herdsmanRowTooltip" extends="fs25_multiTextOptionTooltip">
        <position value="356px 0px"/>
        <width value="330px"/>
    </Profile>
    <!-- TextInput-row variant: a TextInput's value widget is ~31px narrower than the button /
         selector widgets (the pencil-icon box fills the gap), and the tooltip pins to the widget's
         right edge, so a TextInput's tooltip would otherwise sit ~31px left of the other rows. Adding
         that 31px back to the position lands every row's help line on one shared right edge. Used by
         the name / maxAnimals / budgetFixed rows. -->
    <Profile name="rlMenu_herdsmanRowTooltipInput" extends="rlMenu_herdsmanRowTooltip">
        <position value="387px 0px"/>
    </Profile>

    <!-- Per-row REASON line for the herdsman rule editor: a second Text stacked in the same value
         widget, in the same rect as the help line above, carrying the "Required" / bounds string for
         a row whose data is missing or out of domain.

         This profile's colour table is the INVERSE of the help line's, which is what makes the
         idle/focused swap free of any Lua focus hook: the help line is visible only while its parent
         widget is focused or highlighted, so painting this one on the opposite states puts exactly
         one of the two in the shared rect at a time. A focus hook would not survive here anyway -
         the frame's own tint pass invalidates the layout on every render, which re-wraps focus
         handlers on a scrolling layout's children.

         Every state is declared explicitly rather than left to inherit: an undeclared one resolves
         through its own fallback chain, which is how a row ends up painting both strings or neither.
         `textDisabledColor` is deliberately the VISIBLE colour - a disabled row that is still
         missing required data must keep saying so.

         Residual, queued as a manual check: the SELECTED states are not declared by the profile this
         one extends, so a row that is ever `selected` may paint neither string. Whether a row here
         can reach that state is unverified.

         Position / width / colours only - never the anchor. Overriding the anchor knocks the
         inherited sizing traits off the chain and silently disables text wrap, which is why the
         parent profile does not override it either. -->
    <Profile name="rlMenu_herdsmanRowReason" extends="rlMenu_herdsmanRowTooltip">
        <textColor value="$preset_colorOrange"/>
        <textDisabledColor value="$preset_colorOrange"/>
        <textFocusedColor value="$preset_colorTransparent"/>
        <textHighlightedColor value="$preset_colorTransparent"/>
        <textSelectedColor value="$preset_colorTransparent"/>
        <textFocusedSelectedColor value="$preset_colorTransparent"/>
    </Profile>

    <!-- TextInput-row variant, mirroring the tooltip split: a TextInput's value widget is ~31px
         narrower than the button / selector widgets, so its reason line needs the same 387px
         position its help line uses to share one right edge with the other rows. -->
    <Profile name="rlMenu_herdsmanRowReasonInput" extends="rlMenu_herdsmanRowTooltipInput">
        <textColor value="$preset_colorOrange"/>
        <textDisabledColor value="$preset_colorOrange"/>
        <textFocusedColor value="$preset_colorTransparent"/>
        <textHighlightedColor value="$preset_colorTransparent"/>
        <textSelectedColor value="$preset_colorTransparent"/>
        <textFocusedSelectedColor value="$preset_colorTransparent"/>
    </Profile>


</GUIProfiles>
