<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
    herdsmanFrame.xml
    RL Tabbed Menu Herdsman tab: a rule list (master) + rule editor (detail).

    Mirrors the Settings > Filters master-detail but WITHOUT a subcategory tab
    bar: the herdsman frame hosts a single master-detail, so the tab bar,
    its highlighted separator, and the paging selector are all absent. A
    content wrapper using fs25_subCategorySelectorTabbedContainer is KEPT
    (not flattened into fs25_menuContainer): rlMenu_filterEditorContainer
    trims its width by 410px relative to THIS wrapper, and the wrapper also
    reserves the header band - so keeping it preserves the editor's anchor
    context and the list/editor's clearance below the header.

    The list binds to the real rule registry (F3) and the right pane hosts the
    rule editor (F4b: name / operation / enabled / op-params + read-only filter
    and husbandries summaries). The filter / husbandry pickers, the action bar,
    and the legacy-active banner arrive in later herdsman frame slices.
-->
<GUI name="RLMenuHerdsmanFrame">
    <GuiElement profile="fs25_menuContainer">

        <!-- Header with the herdsman icon. id so onFrameOpen can measure its
             bottom edge as the baseline for the list/editor placement. -->
        <GuiElement profile="fs25_menuHeaderPanel" id="headerPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="rlMenu.herdsman"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_rl_menu_herdsman_title"/>
            <!-- Legacy-active coexistence banner: a fixed-text caution directly below the title,
                 hidden until RLMenuHerdsmanFrame:refreshBanner finds an enabled legacy herdsman
                 op on a husbandry. Read-only detection; no legacy code is touched. -->
            <Text profile="rl_herdsmanLegacyBanner" id="legacyBanner"
                  text="$l10n_rl_menu_herdsman_legacy_banner"/>
        </GuiElement>

        <!-- Content wrapper (the kept subCategoryPages[2]-role container). No
             tab bar sits above it, so the master-detail occupies the band the
             tab-bar chrome held in the Settings frame. Final top offset is
             confirmed by the onFrameOpen measurement log and tuned with the
             dev hot-reload, not eyeballed. -->
        <GuiElement profile="rlMenu_herdsmanContentContainer" id="herdsmanContentContainer">

            <!-- Master: rule list sidebar (410px). Mirrors filtersListContainer. -->
            <GuiElement profile="fs25_subCategoryContainer" id="rulesListContainer">
                <Bitmap profile="fs25_subCategoryStartClipper" name="rulesStartClipper"/>
                <Bitmap profile="fs25_subCategoryStopClipper" name="rulesEndClipper"/>

                <SmoothList profile="rl_filterList"
                            id="rulesList"
                            startClipperElementName="rulesStartClipper"
                            endClipperElementName="rulesEndClipper"
                            listSectionHeader="section">
                    <!-- Section header cell (auto-populated via getTitleForSectionHeader);
                         one per operation. rl_filterList extends fs25_subCategoryList,
                         so the section-header profiles compose. -->
                    <ListItem profile="fs25_subCategoryListSectionHeader" name="section">
                        <Text profile="fs25_subCategoryListSectionHeaderTitle" name="title"/>
                    </ListItem>
                    <ListItem profile="rl_filterListItem" name="defaultCell">
                        <Text profile="rl_filterListItemName" name="ruleName"/>
                    </ListItem>
                </SmoothList>

                <Text profile="fs25_animalListEmptyText"
                      id="rulesEmptyState"
                      text="$l10n_rl_menu_herdsman_empty"/>

                <ThreePartBitmap profile="fs25_subCategoryListSliderBox" id="rulesSliderBox">
                    <Slider profile="fs25_listSlider" dataElementId="rulesList" id="rulesSlider"/>
                </ThreePartBitmap>
            </GuiElement>

            <!-- Detail: rule editor (right-side sibling). Reuses the
                 rlMenu_filterEditorContainer profile, which stretches both
                 axes inside this wrapper and trims width by the sidebar's
                 410px so the right edge aligns with the wrapper's right edge.
                 Shell carries only the empty-state text; the editor rows and
                 conditions list are a later slice. -->
            <GuiElement profile="rlMenu_filterEditorContainer" id="ruleEditorContainer">
                <Text profile="fs25_animalListEmptyText"
                      id="ruleEditorEmpty"
                      text="$l10n_rl_menu_herdsman_empty_editor"/>

                <!-- Rule editor (D4 order). Mirrors settingsFrame.xml
                     filterEditorLayout SHAPE: a fs25_settingsLayout ScrollingLayout of
                     fs25_multiTextOptionContainer rows, each wrapping ONE base-game
                     settings widget + its title. Each row container carries an id so
                     RLMenuHerdsmanFrame:refreshRuleDetail can setVisible the whole ROW
                     (widget + title together) from getParamVisibility - hiding the bare
                     widget would leave its title dangling. The Filter row is an in-row
                     rl_settingsButton (button-as-value) that opens the single-select filter
                     picker; the Husbandries row stays a read-only value Text right-aligned in
                     the widget column (its picker is a later slice). Both keep the settings-row
                     style so they tint + align with the editable rows.
                     Fills the right pane (100% height); with per-operation visibility only
                     ~8 rows show at once, so it rarely scrolls. Exact vertical fit is
                     confirmed by the onFrameOpen / refresh measurement log + the dev hot-
                     reload (RLMenu.DEV_RELOAD_XML), not eyeballed. -->
                <ScrollingLayout profile="fs25_settingsLayout" id="ruleEditorLayout"
                                 size="100% 100%"
                                 position="0px 0px">

                    <!-- Per-row help line: each row's tooltip Text lives INSIDE its value
                         widget (the legacy rl_aiTooltip home in AnimalScreen.xml) - the row container
                         clips to its own bounds, so the right-margin tooltip must hang off the
                         non-clipping widget, not the row. rlMenu_herdsmanRowTooltip (anchorMiddleRight)
                         pins it to the widget's right edge + a margin offset; the frame grabs it
                         recursively off the row (getDescendantByName) and sets the text per render. -->

                    <!-- Name (always visible) -->
                    <Bitmap profile="fs25_multiTextOptionContainer" id="ruleNameRow">
                        <TextInput profile="fs25_settingsTextInput" id="ruleNameInput"
                                   onTextChanged="onRuleNameChanged"
                                   focusOnHighlight="true"
                                   imeDescription="$l10n_rl_menu_filters_editor_title_name"
                                   imePlaceholder="$l10n_rl_menu_filters_editor_title_name"
                                   imeTitle="$l10n_rl_menu_filters_editor_title_name">
                            <ThreePartBitmap profile="fs25_textInputBg"/>
                            <Bitmap profile="fs25_textInputIconBox">
                                <Bitmap profile="fs25_textInputIcon"/>
                            </Bitmap>
                            <Text profile="rlMenu_herdsmanRowTooltipInput" name="tooltip"/>
                        </TextInput>
                        <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_rl_menu_filters_editor_title_name"/>
                    </Bitmap>

                    <!-- Operation (5-state; reuses F3's section labels) -->
                    <Bitmap profile="fs25_multiTextOptionContainer" id="ruleOperationRow">
                        <MultiTextOption profile="fs25_settingsMultiTextOption" id="ruleOperationSelector" onClick="onRuleOperationChanged">
                            <Text profile="rlMenu_herdsmanRowTooltip" name="tooltip"/>
                        </MultiTextOption>
                        <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_rl_menu_herdsman_detail_operation"/>
                    </Bitmap>

                    <!-- maxAnimals (numeric TextInput; hidden for castrate/naming) -->
                    <Bitmap profile="fs25_multiTextOptionContainer" id="ruleMaxAnimalsRow">
                        <TextInput profile="fs25_settingsTextInput" id="ruleMaxAnimalsInput"
                                   onTextChanged="onRuleMaxAnimalsChanged"
                                   focusOnHighlight="true"
                                   imeDescription="$l10n_rl_ui_maxAnimals"
                                   imePlaceholder="$l10n_rl_ui_maxAnimals"
                                   imeTitle="$l10n_rl_ui_maxAnimals">
                            <ThreePartBitmap profile="fs25_textInputBg"/>
                            <Bitmap profile="fs25_textInputIconBox">
                                <Bitmap profile="fs25_textInputIcon"/>
                            </Bitmap>
                            <Text profile="rlMenu_herdsmanRowTooltipInput" name="tooltip"/>
                        </TextInput>
                        <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_rl_ui_maxAnimals"/>
                    </Bitmap>

                    <!-- mark (binary; sell/castrate/ai) -->
                    <Bitmap profile="fs25_multiTextOptionContainer" id="ruleMarkRow">
                        <BinaryOption profile="fs25_settingsBinaryOption" id="ruleMarkToggle" onClick="onRuleMarkChanged">
                            <Text profile="rlMenu_herdsmanRowTooltip" name="tooltip"/>
                        </BinaryOption>
                        <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_rl_menu_herdsman_detail_action"/>
                    </Bitmap>

                    <!-- convention (binary, 2-value; naming only) -->
                    <Bitmap profile="fs25_multiTextOptionContainer" id="ruleConventionRow">
                        <BinaryOption profile="fs25_settingsBinaryOption" id="ruleConventionToggle" onClick="onRuleConventionChanged">
                            <Text profile="rlMenu_herdsmanRowTooltip" name="tooltip"/>
                        </BinaryOption>
                        <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_rl_menu_herdsman_detail_convention"/>
                    </Bitmap>

                    <!-- budget.type (binary, 2-value; buy only) -->
                    <Bitmap profile="fs25_multiTextOptionContainer" id="ruleBudgetTypeRow">
                        <BinaryOption profile="fs25_settingsBinaryOption" id="ruleBudgetTypeToggle" onClick="onRuleBudgetTypeChanged">
                            <Text profile="rlMenu_herdsmanRowTooltip" name="tooltip"/>
                        </BinaryOption>
                        <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_rl_ui_budgetType"/>
                    </Bitmap>

                    <!-- budget.fixed (numeric TextInput; buy + budget.type=fixed) -->
                    <Bitmap profile="fs25_multiTextOptionContainer" id="ruleBudgetFixedRow">
                        <TextInput profile="fs25_settingsTextInput" id="ruleBudgetFixedInput"
                                   onTextChanged="onRuleBudgetFixedChanged"
                                   focusOnHighlight="true"
                                   imeDescription="$l10n_rl_menu_herdsman_detail_budgetfixed"
                                   imePlaceholder="$l10n_rl_menu_herdsman_detail_budgetfixed"
                                   imeTitle="$l10n_rl_menu_herdsman_detail_budgetfixed">
                            <ThreePartBitmap profile="fs25_textInputBg"/>
                            <Bitmap profile="fs25_textInputIconBox">
                                <Bitmap profile="fs25_textInputIcon"/>
                            </Bitmap>
                            <Text profile="rlMenu_herdsmanRowTooltipInput" name="tooltip"/>
                        </TextInput>
                        <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_rl_menu_herdsman_detail_budgetfixed"/>
                    </Bitmap>

                    <!-- budget.percentage (MultiTextOption over the 28-value whitelist;
                         buy + budget.type=percentage). Option texts are the frame's
                         tostring(v).."%" render. -->
                    <Bitmap profile="fs25_multiTextOptionContainer" id="ruleBudgetPercentageRow">
                        <MultiTextOption profile="fs25_settingsMultiTextOption" id="ruleBudgetPercentageSelector" onClick="onRuleBudgetPercentageChanged">
                            <Text profile="rlMenu_herdsmanRowTooltip" name="tooltip"/>
                        </MultiTextOption>
                        <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_rl_menu_herdsman_detail_budgetpercentage"/>
                    </Bitmap>

                    <!-- semen (MultiTextOption; ai only; options enumerated live from
                         g_dewarManager, "any" prepended by the frame) -->
                    <Bitmap profile="fs25_multiTextOptionContainer" id="ruleSemenRow">
                        <MultiTextOption profile="fs25_settingsMultiTextOption" id="ruleSemenSelector" onClick="onRuleSemenChanged">
                            <Text profile="rlMenu_herdsmanRowTooltip" name="tooltip"/>
                        </MultiTextOption>
                        <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_rl_menu_herdsman_detail_semen"/>
                    </Bitmap>

                    <!-- Filter (interactive; hidden for naming). Button-as-value: an in-row
                         rl_settingsButton whose label is the bound filter's name (or (none) /
                         (missing)) and whose click opens the single-select filter picker.
                         Mirrors the Settings general-tab button row (rl_settingsButton +
                         fs25_settingsButtonBg, tinted by updateAlternatingElements). The frame
                         setTexts the label via getFilterSummary on each render. -->
                    <Bitmap profile="fs25_multiTextOptionContainer" id="ruleFilterRow">
                        <Button profile="rl_settingsButton" id="ruleFilterButton" onClick="onClickRuleFilter">
                            <ThreePartBitmap profile="fs25_settingsButtonBg"/>
                            <Text profile="rlMenu_herdsmanRowTooltip" name="tooltip"/>
                        </Button>
                        <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_rl_menu_info_filter_button"/>
                    </Bitmap>

                    <!-- Husbandries (interactive; always visible). Button-as-value: an in-row
                         rl_settingsButton whose label is the count form ("N selected" / a single
                         husbandry name / a "select husbandries" CTA) and whose click opens the
                         multi-select husbandry picker. Mirrors the Filter row above
                         (rl_settingsButton + fs25_settingsButtonBg, tinted by
                         updateAlternatingElements). The frame setTexts the label via
                         formatHusbandryButtonLabel on each render. -->
                    <Bitmap profile="fs25_multiTextOptionContainer" id="ruleHusbandriesRow">
                        <Button profile="rl_settingsButton" id="ruleHusbandriesButton" onClick="onClickRuleHusbandries">
                            <ThreePartBitmap profile="fs25_settingsButtonBg"/>
                            <Text profile="rlMenu_herdsmanRowTooltip" name="tooltip"/>
                        </Button>
                        <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_rl_menu_herdsman_detail_husbandries"/>
                    </Bitmap>

                    <!-- Destination (move only; hidden for other ops via setRowVisible). Button-as-value:
                         an in-row rl_settingsButton whose label is the chosen destination husbandry name
                         (or a "Select destination" CTA / (missing)) and whose click opens the SINGLE-select
                         destination picker. Mirrors the Husbandries row above (rl_settingsButton +
                         fs25_settingsButtonBg, tinted + collapsed by updateAlternatingElements). The frame
                         setTexts the label via formatDestinationButtonLabel on each render. -->
                    <Bitmap profile="fs25_multiTextOptionContainer" id="ruleDestinationRow">
                        <Button profile="rl_settingsButton" id="ruleDestinationButton" onClick="onClickRuleDestination">
                            <ThreePartBitmap profile="fs25_settingsButtonBg"/>
                            <Text profile="rlMenu_herdsmanRowTooltip" name="tooltip"/>
                        </Button>
                        <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_rl_menu_herdsman_detail_destination"/>
                    </Bitmap>

                    <!-- Enabled (binary). LAST row by design: enabling is the commit
                         step, not a parameter - the flush gate makes the filter / husbandries /
                         destination requirements enabled-conditional (RLHerdsmanRulePresenter
                         validateEdit / validateFlush), so the toggle belongs after the rows that
                         satisfy those gates. Row order here IS the pane order; the frame resolves
                         every row by id, and updateAlternatingElements re-derives the tint stripe
                         from this element order on each render. -->
                    <Bitmap profile="fs25_multiTextOptionContainer" id="ruleEnabledRow">
                        <BinaryOption profile="fs25_settingsBinaryOption" id="ruleEnabledToggle" onClick="onRuleEnabledChanged">
                            <Text profile="rlMenu_herdsmanRowTooltip" name="tooltip"/>
                        </BinaryOption>
                        <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_rl_menu_herdsman_detail_enabled"/>
                    </Bitmap>

                </ScrollingLayout>
            </GuiElement>

        </GuiElement>

    </GuiElement>
</GUI>
