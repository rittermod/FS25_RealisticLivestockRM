<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
	<GuiElement profile="newLayer"/>
	<Bitmap profile="dialogFullscreenBg" id="dialogBg"/>
	<GuiElement profile="rl_animalFilterDialog" id="dialogElement" width="1120px">
		<ThreePartBitmap profile="fs25_dialogBgMiddleSmall"/>
		<ThreePartBitmap profile="fs25_dialogBgTopSmall"/>
		<ThreePartBitmap profile="fs25_dialogBgBottom"/>

		<GuiElement profile="rl_animalFilterDialogContainer">

			<GuiElement profile="rl_headerContainer" position="39px -53.5px">

				<Text profile="rl_diseaseListHeaderText" position="5px 0px" width="380px" text="$l10n_rl_disease" id="titleHeader"/>
				<Text profile="rl_diseaseListHeaderText" position="395px 0px" width="250px" text="$l10n_ui_missionStatusTitle" id="statusHeader"/>
				<Text profile="rl_diseaseListHeaderText" position="655px 0px" width="165px" text="$l10n_rl_ui_duration" id="durationHeader"/>
				<Text profile="rl_diseaseListHeaderText" position="830px 0px" width="170px" text="$l10n_rl_ui_fee" id="feeHeader"/>
				<ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px -2dp"/>

			</GuiElement>

			<SmoothList profile="rl_husbandryList" id="diseaseList" position="46.5px -83.5px">
				<ListItem profile="rl_husbandryListItem">
					<Text profile="rl_husbandryListTextRight" position="5px 0px" size="380px 32px" name="title"/>
					<Text profile="rl_husbandryListTextRight" position="395px 0px" size="250px 32px" name="status"/>
					<Text profile="rl_husbandryListTextRight" position="655px 0px" size="165px 32px" name="duration"/>
					<Text profile="rl_husbandryListTextRight" position="830px 0px" size="170px 32px" name="fee"/>
				</ListItem>
			</SmoothList>
			
		</GuiElement>
		
		<BoxLayout profile="fs25_dialogButtonBox" id="buttonsPC">
			<Button profile="buttonOK" text="$l10n_rl_ui_startTreatment" onClick="onClickOk" id="yesButton"/>
			<Bitmap profile="fs25_dialogButtonBoxSeparator"/>
			<Button profile="buttonCancel" text="$l10n_rl_ui_cull" onClick="onClickCull" id="cullButton"/>
			<Bitmap profile="fs25_dialogButtonBoxSeparator"/>
			<Button profile="buttonBack" text="$l10n_rl_button_cancel" onClick="onClickBack" id="noButton"/>
		</BoxLayout>
	</GuiElement>
</GUI>